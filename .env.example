# Backend API base URL (required)
# e.g. VITE_BASE_URL="https://api-bisa-nota.vercel.app"
# Local dev: VITE_BASE_URL="http://localhost:5001"
VITE_BASE_URL=

# Customer self-order app base URL (BISA-MAKAN-APP) used by Table QR codes.
# Defaults to "https://order-app-dun.vercel.app" when not set.
VITE_ORDER_APP_URL=
